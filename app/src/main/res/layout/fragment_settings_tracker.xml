<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_settings"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_set_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_start_date"
        app:icon="@drawable/ic_settings_black_24dp"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_set_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_location"
        app:icon="@drawable/ic_location"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_change_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/change_language"
        app:icon="@android:drawable/ic_menu_sort_alphabetically"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_edit_api"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_api"
        app:icon="@android:drawable/ic_menu_edit"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_read_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/read_logs"
        app:icon="@android:drawable/ic_menu_info_details"
        style="@style/Widget.Material3.Button.TonalButton" />

</LinearLayout>